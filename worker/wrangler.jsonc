{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "survivor-p2p-signal",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SignalRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }
  ]
}
